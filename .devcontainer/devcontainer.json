{
  // Entorno de GitHub Codespaces: el mismo Python y Java para los dos integrantes.
  "name": "secop-prorrogas",
  // Imagen oficial de Microsoft con Python 3.12.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  // Spark en modo local necesita memoria: se pide una máquina de al menos 8 GB.
  // Para el pipeline completo con datos reales conviene elegir una de 4 núcleos.
  "hostRequirements": { "memory": "8gb" },
  "features": {
    // PySpark necesita Java 17 o superior.
    "ghcr.io/devcontainers/features/java:1": { "version": "17" },
    // Para construir y probar la imagen con "make docker" dentro de Codespaces.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // Al crear el Codespace: instalar dependencias fijadas y validar el esquema.
  "postCreateCommand": "pip install -r requirements-dev.txt && python scripts/validar_esquema.py",
  // Puertos que Codespaces abre en el navegador: 5000 = MLflow, 4040 = interfaz de Spark.
  "forwardPorts": [5000, 4040],
  "portsAttributes": {
    "5000": { "label": "MLflow" },
    "4040": { "label": "Spark UI" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter", "charliermarsh.ruff"]
    }
  }
}
